{
  "name": "madxp-central-server",
  "version": "1.0.0",
  "description": "Serveur central de gestion de flotte NEOPRO",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && cp -r src/docs dist/ && cp -r src/templates dist/ && mkdir -p dist/scripts/migrations && cp src/scripts/migrations/*.sql dist/scripts/migrations/",
    "start": "node dist/scripts/migrate.js && node --max-old-space-size=512 --expose-gc dist/server.js",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "db:migrate:prod": "DATABASE_URL=$RAILWAY_DATABASE_URL ts-node src/scripts/migrate.ts",
    "db:seed": "ts-node src/scripts/seed.ts",
    "create-admin": "ts-node src/scripts/create-admin.ts",
    "hotspot:status": "ts-node src/scripts/hotspot-bootstrap-status.ts",
    "db:backfill-video-durations": "ts-node src/scripts/backfill-video-durations.ts",
    "backfill:displays-resync": "ts-node src/scripts/backfill-displays-resync.ts",
    "backfill:config-video-paths": "ts-node src/scripts/backfill-config-video-paths.ts",
    "backfill:loop-video-owner": "ts-node src/scripts/backfill-loop-video-owner.ts",
    "audit:orphan-sponsors": "ts-node src/scripts/audit-orphan-site-sponsors.ts",
    "audit:variants-drift": "ts-node src/scripts/audit-variants-drift.ts",
    "led:cleanup-bulk-variants": "tsx src/scripts/cleanup-bulk-led-variants.ts",
    "backfill:video-dimensions": "tsx src/scripts/backfill-video-dimensions.ts",
    "audit:ftp-legacy": "ts-node src/scripts/audit-ftp-legacy-videos.ts",
    "audit:profile-filename-orphans": "ts-node src/scripts/audit-config-profile-filename-orphans.ts",
    "rotate:ftp-creds": "ts-node src/scripts/rotate-ftp-creds.ts",
    "led:ribbon-poc": "ts-node src/scripts/led-ribbon-poc.ts",
    "led:export": "ts-node src/scripts/led-export.ts",
    "led:fold-per-side": "ts-node src/scripts/led-fold-per-side-poc.ts",
    "led:mire": "ts-node src/scripts/led-mire.ts",
    "test": "jest",
    "test:smoke": "jest --verbose --no-coverage --forceExit '__tests__/smoke/'",
    "test:smoke:smart": "bash src/scripts/smart-smoke.sh",
    "lint": "eslint --no-warn-ignored src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > ../docs/technical/graphs/central-server.svg && echo '✓ central-server.svg'",
    "graph:archi": "depcruise src --config .dependency-cruiser.cjs --output-type archi | dot -T svg > ../docs/technical/graphs/central-server-archi.svg && echo '✓ central-server-archi.svg'",
    "graph:domain": "depcruise src/controllers/$DOMAIN.controller.ts src/services --config .dependency-cruiser.cjs --output-type dot | dot -T svg > ../docs/technical/graphs/$DOMAIN.svg && echo '✓ $DOMAIN.svg'"
  },
  "keywords": [
    "neopro",
    "fleet-management",
    "raspberry-pi"
  ],
  "author": "NEOPRO Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@logtail/node": "^0.5.2",
    "@logtail/winston": "^0.5.2",
    "@remotion/bundler": "^4.0.448",
    "@remotion/renderer": "^4.0.448",
    "@types/pdfkit": "^0.17.4",
    "basic-ftp": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "yaml": "^2.8.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.21",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/yamljs": "^0.2.34",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "optionalDependencies": {
    "canvas": "^3.1.0",
    "chartjs-node-canvas": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
