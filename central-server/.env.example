# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database (PostgreSQL)
# IMPORTANT (ADR-070, issue #863) : ne PAS utiliser une URL `*.supabase.co` —
# l'instance Supabase historique est orpheline depuis la migration Railway.
# Le serveur refuse de booter si DATABASE_URL contient `supabase.co`.
# Pour requêter la DB prod en local, utiliser : ./scripts/use-prod-db.sh
DATABASE_URL=postgresql://user:password@localhost:5432/neopro_central
# Cibles explicites pour db:migrate:prod et db:migrate:backup
RAILWAY_DATABASE_URL=postgresql://user:password@roundhouse.proxy.rlwy.net:PORT/railway
DATABASE_SSL=false
# DB_POOL_MAX : nombre max de connexions dans le pool (defaut: 10, clamp 1-50)
# Railway Hobby : 5-10 | Railway Pro / Render Standard : 15-20
DB_POOL_MAX=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (include Raspberry Pi origins for local TV displays)
#
# ADR-133 Phase 7 prep : penser à ajouter le futur domaine MadXP côté
# Railway env vars dès qu'il est configuré en DNS :
#   https://madxp.kalonpartners.bzh
# (un seul domaine — il remplace `neopro-admin.kalonpartners.bzh` qui
#  servait à la fois dashboard admin ET portail club SaaS sous /saas/).
# L'ancien domaine peut rester pendant la transition pour éviter de casser
# les onglets dashboard déjà ouverts.
ALLOWED_ORIGINS=http://localhost:4200,https://control.neopro.fr,http://neopro.local,http://neopro.local:4200,http://192.168.4.1,http://192.168.4.1:4200

# FTP Storage - Hostinger (stockage UNIQUE des videos en production - ADR-085)
# IMPORTANT: Utiliser l'IP directe (72.60.93.193) car ftp.kalonpartners.bzh ne resout pas en DNS
#
# REBRAND NEOPRO → MADXP (ADR-133, Phase 6) :
#   - Defaults ci-dessous = LEGACY (compte FTP `u406531085.videos`, path `/neopro-video/`)
#   - Cible post-migration : FTP_USER=u406531085.madxpvideos + FTP_PUBLIC_URL=https://kalonpartners.bzh/madxp-video
#   - Procédure : docs/runbooks/RUNBOOK_FTP_REBRAND_MIGRATION.md
#   - Audit pré-migration : npx ts-node src/scripts/audit-ftp-path-rebrand.ts
FTP_HOST=72.60.93.193
FTP_PORT=21
FTP_USER=u406531085.videos
FTP_PASSWORD=your-ftp-password
FTP_SECURE=false
FTP_PUBLIC_URL=https://kalonpartners.bzh/neopro-video

# FTP Storage pour les mises à jour logicielles (séparé des vidéos)
# IMPORTANT: Utiliser l'IP directe (72.60.93.193) car ftp.kalonpartners.bzh ne résout pas en DNS
# Cible post-rebrand : FTP_UPDATE_USER=u406531085.updatemadxp + FTP_UPDATE_PUBLIC_URL=https://kalonpartners.bzh/madxp-update
FTP_UPDATE_HOST=72.60.93.193
FTP_UPDATE_PORT=21
FTP_UPDATE_USER=u406531085.updateneopro
FTP_UPDATE_PASSWORD=your-ftp-update-password
FTP_UPDATE_SECURE=false
FTP_UPDATE_PUBLIC_URL=https://kalonpartners.bzh/neopro-update

# Email (pour alertes et notifications)
# Configuration Gmail: utiliser un "App Password" (pas le mot de passe normal)
# 1. Activer 2FA sur votre compte Google
# 2. Creer un App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=NeoPro <noreply@neopro.fr>
SMTP_SECURE=false

# ADR-058 Phase 2C — Alertmanager security email routing
# Adresse destinataire des alertes security (brute-force PIN, lockouts)
ALERT_EMAIL_TO=super-admin@neopro.fr
ALERT_EMAIL_FROM=noreply@neopro.fr

# Logging
LOG_LEVEL=info

# Metrics (Grafana Cloud scraping)
# Token Bearer pour sécuriser l'endpoint /metrics
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_BEARER_TOKEN=

# Logtail (Better Stack) - Centralized logging
LOGTAIL_TOKEN=

# Slack Alerts
SLACK_WEBHOOK_URL=
SLACK_ALERTS_ENABLED=false

# ============================================
# Frontend URLs (utilisés pour les liens dans les emails et redirections)
# ============================================
FRONTEND_URL=http://localhost:4200
DASHBOARD_URL=http://localhost:4300

# ============================================
# Alerting webhook (optionnel - endpoint externe pour les alertes critiques)
# ============================================
ALERTING_WEBHOOK_URL=

# ============================================
# Video Processing
# ============================================
VIDEO_COMPRESSION_THRESHOLD_MB=100
THUMBNAIL_DIR=./uploads/thumbnails

# ============================================
# Admin State (fichier JSON pour l'état persistant du serveur admin)
# ============================================
ADMIN_STATE_FILE=./data/admin-state.json

# ============================================
# Database SSL certificates (optionnel - pour connexions SSL personnalisées)
# ============================================
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# DATABASE_SSL_CA_PATH=

# ============================================
# GitHub API (persistance proposals SAFe dans le repo git)
# Fine-grained token, scope : Contents (read + write) sur le repo neopro
# https://github.com/settings/personal-access-tokens/new
# ============================================
GITHUB_TOKEN=
# GITHUB_REPO=Tallec7/neopro  (défaut)
# GITHUB_BRANCH=main           (défaut)
