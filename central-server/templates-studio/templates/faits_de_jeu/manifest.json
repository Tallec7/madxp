{
  "id": "faits_de_jeu",
  "version": "1.0.0",
  "label": "FAITS DE JEU",
  "kind": "video",
  "description": "Bandeau plein écran (2MIN, PÉNALTY, CARTON, etc).",
  "inputSchema": {
    "type": "object",
    "required": ["label"],
    "properties": {
      "label": {
        "type": "string",
        "label": "Type",
        "enum": ["2MIN", "PÉNALTY", "CARTON JAUNE", "CARTON ROUGE", "CHANGEMENT"]
      }
    }
  },
  "bindings": {
    "label": { "source": "input.label" }
  },
  "format": { "width": 1920, "height": 1080, "fps": 25, "durationInFrames": 250 },
  "compositionId": "FaitsDeJeuStory",
  "requiredAssets": [
    {
      "key": "metalTexture",
      "filename": "metal_texture.png",
      "mime": "image/png"
    },
    {
      "key": "lensFlare",
      "filename": "lens_flare_web.mp4",
      "mime": "video/mp4"
    },
    {
      "key": "watermarkNeopro",
      "filename": "watermark_neopro.png",
      "mime": "image/png"
    }
  ]
}
