{
  "name": "neopro-templates-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "POC Remotion — templates vidéo Neopro",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ButSimple out/but-simple.mp4",
    "render:preview": "remotion render ButSimple out/but-simple.mp4 --props='{ \"prenom\": \"KEVIN\", \"nom\": \"DUPONT\", \"club\": \"FC NANTES\" }'",
    "render:v1": "remotion render JoueurButGeneriqueV1 out/joueur-but-v1.mp4 --timeout=180000",
    "build:preview": "vite build --config preview/vite.config.ts",
    "dev:studio": "vite --config studio-poc/vite.config.ts",
    "studio:server": "node studio-poc/server.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
