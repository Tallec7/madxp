# Neopro — HDMI hotplug notification (E-23 US-23.1.3)
# Déployé automatiquement via OTA dans /etc/udev/rules.d/
#
# Détecte les événements DRM "change" (branchement/débranchement d'écran HDMI)
# et écrit un flag file pour que le kiosk-watchdog.sh réagisse immédiatement
# au lieu d'attendre le prochain cycle de polling.

ACTION=="change", SUBSYSTEM=="drm", KERNEL=="card*", RUN+="/usr/local/bin/neopro-hdmi-notify.sh"
