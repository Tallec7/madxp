# Neopro USB WiFi Initialization
# S'exécute AVANT le sync-agent pour s'assurer que wlan1 est prêt.
# Si la clé USB WiFi n'apparaît pas au boot, tente modprobe + USB power-cycle.
# Sort exit 0 même en cas d'échec pour ne pas bloquer les Pi Ethernet-only.

[Unit]
Description=Neopro USB WiFi Initialization
After=network.target
Before=neopro-sync-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root

ExecStart=/home/pi/neopro/scripts/usb-wifi-init.sh

TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
