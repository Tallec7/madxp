# Systemd service pour le mode Kiosque Neopro
# Lance Chromium en fullscreen sur /tv au démarrage
# Inclut un watchdog qui détecte et récupère des crashs "Aw, Snap!"

[Unit]
Description=Neopro Kiosk Mode (TV Display) with Watchdog
After=graphical.target neopro-app.service
Wants=graphical.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

# Attendre que le serveur X soit prêt (max 60s, check toutes les 2s)
# Remplace le sleep fixe 10s qui échouait si X n'était pas encore prêt
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do DISPLAY=:0 xdpyinfo >/dev/null 2>&1 && exit 0; sleep 2; done; echo "X server not ready after 60s" >&2; exit 1'

# Lancement du watchdog qui gère Chromium
# Le watchdog détecte les crashs "Aw, Snap!" et relance automatiquement
ExecStart=/home/pi/neopro/scripts/kiosk-watchdog.sh

# Arrêt propre
ExecStop=/usr/bin/pkill -9 -f chromium

# Redémarrage automatique du watchdog si il crash
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
