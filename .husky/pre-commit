#!/bin/sh
# Pre-commit hook for NEOPRO
# Runs lint-staged to check and fix code before committing

# Check i18n key synchronization
echo "Checking i18n key synchronization..."
node scripts/check-i18n.js
if [ $? -ne 0 ]; then
  echo ""
  echo "i18n keys are out of sync!"
  echo "Run 'npm run i18n:fix' to add missing keys with placeholders."
  echo ""
  exit 1
fi

# Check for hardcoded French text in staged files
echo "Checking for hardcoded French text..."
node scripts/check-hardcoded-i18n.js --staged
if [ $? -ne 0 ]; then
  echo ""
  echo "Hardcoded French text detected in staged files!"
  echo "Please use translation keys instead."
  echo "Run 'npm run i18n:hardcoded' to see all issues."
  echo ""
  exit 1
fi

# Auto-regenerate SAFe Excel if any docs/safe/*.md changed
SAFE_MD_CHANGED=$(git diff --cached --name-only -- 'docs/safe/*.md' | head -1)
if [ -n "$SAFE_MD_CHANGED" ]; then
  echo "SAFe .md files changed — regenerating Excel portfolio..."
  if command -v python3 >/dev/null 2>&1 && python3 -c "import openpyxl" 2>/dev/null; then
    python3 docs/safe/scripts/export-to-excel.py --output docs/safe/NEOPRO_SAFe_Portfolio.xlsx
    git add docs/safe/NEOPRO_SAFe_Portfolio.xlsx
    echo "✅ Excel portfolio updated and staged."
  else
    echo "⚠️  Skipping Excel generation (openpyxl not installed)"
  fi
fi

npx lint-staged
