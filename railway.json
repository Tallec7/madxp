{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "sh -c 'cd central-server && npm install --include=dev && npm run build'"
  },
  "deploy": {
    "startCommand": "sh -c 'cd central-server && npm start'",
    "healthcheckPath": "/live",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
